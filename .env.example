# Copy to .env (git-ignored). Loaded by lb_worker.py and forwarded to Runpod workers via Endpoint(env=...).
HF_TOKEN=hf_xxx                # required: facebook/sam3 is a gated repo (accept terms on the model page first)
RUNPOD_API_KEY=rpa_xxx         # or run `uv run flash login`
# SAM3_DATACENTER=EU_RO_1      # network-volume datacenter (pins the endpoint); see runpod_flash DataCenter enum
# SAM3_DTYPE=bfloat16          # dtype on the Runpod GPU workers
